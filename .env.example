# Aktive Kundeninstanz (Ordnername in src/customers/)
NEXT_PUBLIC_CUSTOMER_ID=sawin

# Supabase (Staging- bzw. Produktionsprojekt im Konto des Kunden, Region Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig – niemals mit NEXT_PUBLIC_ versehen
SUPABASE_SERVICE_ROLE_KEY=   # Secret Key (sb_secret_…), nur Server und Tests
SUPABASE_DB_URL=             # nur lokal für Migrationen: Session-Pooler-Verbindung mit Passwort, nicht auf Vercel
SUPABASE_ACCESS_TOKEN=       # nur lokal: persönliches Supabase-Token zum Einspielen der Auth-Einstellungen
SUPABASE_AUTH_SITE_URL=http://localhost:3000   # Adresse der App für Links in Auth-E-Mails
LEXWARE_API_KEY=            # Staging: eigenes Lexware-Testkonto (XL), nie Sawins echtes Konto
CRON_SECRET=                # Vercel-Cron (Zahlungsabgleich): zufällige Zeichenkette, mindestens 16 Zeichen
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
