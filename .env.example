# Umgebungsvariablen der App (nie einchecken; Vorlage ohne Werte: .env.example). Beschreibung: docs/uebergabe.md.

# ==============================================================================================================
# 1. STAGING – bleibt dauerhaft so
# Lokale Entwicklung, Tests und Skripte laufen gegen das Staging-Projekt und das Lexware-Testkonto.
# ==============================================================================================================

# Aktive Kundeninstanz = Ordnername in src/customers/ (bei Sawin: sawin). Nicht geheim.
NEXT_PUBLIC_CUSTOMER_ID=

# Supabase-Dashboard (supabase.com/dashboard) › Staging-Projekt › Project Settings › Data API › Project URL. Nicht geheim.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase-Dashboard (supabase.com/dashboard) › Staging-Projekt › Project Settings › API Keys › Publishable key (sb_publishable_…). Nicht geheim.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase-Dashboard (supabase.com/dashboard) › Staging-Projekt › Project Settings › API Keys › Secret keys (sb_secret_…). GEHEIM (umgeht RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase-Dashboard (supabase.com/dashboard) › Staging-Projekt › Connect › Session pooler (Verbindungszeichenkette; Passwort unter Project Settings › Database › Reset database password). GEHEIM. Nur lokal, nie in Vercel.
SUPABASE_DB_URL=

# supabase.com › Account (oben rechts) › Access Tokens (persönlich, sbp_…). GEHEIM, wirkt für alle Projekte des Kontos. Nur lokal, für npm run auth:push.
SUPABASE_ACCESS_TOKEN=

# Adresse der App für Links in Auth-E-Mails (lokal http://localhost:3000, sonst die Staging-Adresse auf Vercel). Nicht geheim.
SUPABASE_AUTH_SITE_URL=

# Ref des Staging-Projekts = Teil der Project URL vor .supabase.co. Tests und staging:leeren laufen nur dagegen. Nicht geheim. Nie für Produktion setzen.
ERLAUBTES_TESTPROJEKT=

# Lexware Office des TESTKONTOS › Einstellungen › Erweiterungen › Public API (app.lexware.de/addons/public-api) › Schlüssel erzeugen. GEHEIM. Nie Sawins echtes Lexware.
LEXWARE_API_KEY=

# Selbst erzeugen (z. B. openssl rand -hex 32), mindestens 16 Zeichen; gleicher Wert wie in Vercel › Settings › Environment Variables (Preview). Nur nötig, um die Crons lokal aufzurufen. GEHEIM.
CRON_SECRET=

# Microsoft Entra Admin Center (entra.microsoft.com) › Identität › Anwendungen › App-Registrierungen › <App der Ablage> › Übersicht › Verzeichnis-ID (Mandanten-ID). Nicht geheim.
MS_GRAPH_TENANT_ID=

# Microsoft Entra Admin Center (entra.microsoft.com) › Identität › Anwendungen › App-Registrierungen › <App der Ablage> › Übersicht › Anwendungs-ID (Client-ID). Nicht geheim.
MS_GRAPH_CLIENT_ID=

# Microsoft Entra Admin Center (entra.microsoft.com) › Identität › Anwendungen › App-Registrierungen › <App der Ablage> › Zertifikate & Geheimnisse › Geheime Clientschlüssel › Wert (nur direkt nach dem Anlegen sichtbar). GEHEIM.
MS_GRAPH_CLIENT_SECRET=

# Selbst erzeugen: openssl rand -base64 32 (32 Byte); verschlüsselt das Graph-Token in der Datenbank. Je Umgebung ein eigener Wert. GEHEIM.
MS_TOKEN_SCHLUESSEL=

# In Staging LEER lassen. Nur Produktion: aktiv (Lexware-IDs übernommener Belege nutzen, docs/airtable-uebernahme.md). Nicht geheim.
LEXWARE_ALTBESTAND=

# In Staging LEER lassen. Nur Produktion: aktiv (OneDrive-Ordner übernommener Aufträge nutzen). Nicht geheim.
ONEDRIVE_ALTBESTAND=

# Optional: aus = „Umgesetzt von“ unter der Anmeldung ausblenden; leer = anzeigen. Nicht geheim.
UMGESETZT_VON=

# airtable.com › Builder Hub › Personal access tokens (nur Lesen auf die Sawin-Base). GEHEIM. Nach dem Go-live widerrufen und hier löschen.
AIRTABLE_TOKEN=

# ID der Airtable-Base (app…, steht in der Adresse der Base). Nicht geheim. Nach dem Go-live löschen.
AIRTABLE_BASE_ID=

# ==============================================================================================================
# 2. NUR FÜR CLAUDE CODE, TEMPORÄR FÜR DIE PRODUKTION – nach Einspielen wieder löschen
# Werte des Produktionsprojekts für einzelne Schritte am Go-live (Migrationen, Auth-Einstellungen, ersten Admin
# einladen, Datenübernahme, Go-live-Prüfung). Die Skripte lesen die Namen ohne _PROD: Claude Code setzt sie nur für den
# einzelnen Aufruf bzw. schreibt sie in eine temporäre .env.produktion. Tests nutzen sie nie (ERLAUBTES_TESTPROJEKT).
# Nach dem Einspielen die Werte wieder löschen (Einträge leer lassen).
# ==============================================================================================================

# Supabase-Dashboard (supabase.com/dashboard) › Produktionsprojekt › Project Settings › Data API › Project URL. Nicht geheim. Nach Einspielen wieder löschen.
NEXT_PUBLIC_SUPABASE_URL_PROD=

# Supabase-Dashboard (supabase.com/dashboard) › Produktionsprojekt › Connect › Session pooler (mit Datenbankpasswort). GEHEIM. Für npm run db:push in Produktion. Nach Einspielen wieder löschen.
SUPABASE_DB_URL_PROD=

# Supabase-Dashboard (supabase.com/dashboard) › Produktionsprojekt › Project Settings › API Keys › Secret keys. GEHEIM. Für ersten Admin einladen und Datenübernahme. Nach Einspielen wieder löschen.
SUPABASE_SERVICE_ROLE_KEY_PROD=

# Produktionsadresse der App (Vercel › Projekt › Settings › Domains). Nicht geheim. Für npm run auth:push in Produktion. Nach Einspielen wieder löschen.
SUPABASE_AUTH_SITE_URL_PROD=

# Sawins Lexware Office › Einstellungen › Erweiterungen › Public API (von Sawin erzeugen lassen). GEHEIM. Nur für golive:pruefen, Datenübernahme (--lexware-lesen) und den Webhook. Nach Einspielen wieder löschen.
LEXWARE_API_KEY_PROD=

# ==============================================================================================================
# 3. NICHT IN .env.local – nur in Vercel, Umgebung „Production“
# Vercel › Projekt › Settings › Environment Variables › Environment: Production. Geheime Werte als „Sensitive“ anlegen.
# Diese Liste nur als Merkzettel, ohne Werte:
#   NEXT_PUBLIC_CUSTOMER_ID               (sawin)
#   NEXT_PUBLIC_SUPABASE_URL              (Produktionsprojekt)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (Produktionsprojekt)
#   SUPABASE_SERVICE_ROLE_KEY             (Produktionsprojekt, GEHEIM, Sensitive)
#   LEXWARE_API_KEY                       (Sawins Lexware, GEHEIM, Sensitive)
#   CRON_SECRET                           (eigener Wert für Produktion, GEHEIM, Sensitive)
#   MS_GRAPH_TENANT_ID                    (Entra, Übersicht)
#   MS_GRAPH_CLIENT_ID                    (Entra, App-Registrierung der Produktion)
#   MS_GRAPH_CLIENT_SECRET                (Entra, GEHEIM, Sensitive)
#   MS_TOKEN_SCHLUESSEL                   (eigener Wert für Produktion, GEHEIM, Sensitive)
#   LEXWARE_ALTBESTAND                    (aktiv)
#   ONEDRIVE_ALTBESTAND                   (aktiv)
#   UMGESETZT_VON                         (optional: aus)
# Nie in Vercel: SUPABASE_DB_URL, SUPABASE_ACCESS_TOKEN, ERLAUBTES_TESTPROJEKT, AIRTABLE_TOKEN, AIRTABLE_BASE_ID
# und alle *_PROD-Einträge aus Abschnitt 2.
# ==============================================================================================================
